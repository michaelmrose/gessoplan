{:tasks
 {gen-org
  {:doc "Assemble the canonical Org document"
   :task (do
           (shell "mkdir" "-p" "output")
           (shell "sh" "-c"
                  "cat src/*/*.org > output/gesso-plan-v5.1.org"))}
  gen
  {:doc "Generate the original Org and PDF"
   :depends [gen-org]
   :task (shell "fish" "-c" "orgToPdf output/gesso-plan-v5.1.org")}
  pretty-org
  {:doc "Generate a presentation-only Florilegium Org copy; optional profile and seed"
   :depends [gen-org]
   :task
   (let [args *command-line-args*
         profile (or (first args)
                     (System/getenv "GESSOPLAN_PRETTY_PROFILE")
                     "gothic")
         seed (or (second args)
                  (System/getenv "GESSOPLAN_PRETTY_SEED"))]
     (when (> (count args) 2)
       (throw (ex-info "Usage: bb pretty-org [gothic|botanical|math|geometric] [seed]"
                       {:args args})))
     (when-not (#{"gothic" "botanical" "math" "geometric"} profile)
       (throw (ex-info (str "Unknown Florilegium profile: " profile)
                       {:profile profile})))
     (apply shell
            (cond-> ["python3" "script/pretty/make_pretty.py"
                     "output/gesso-plan-v5.1.org"
                     "output/gesso-plan-v5.1-pretty.org"
                     "--profile" profile]
              seed (conj "--seed" seed))))}
  pretty
  {:doc "Generate Florilegium PDF; optional profile and seed arguments"
   :depends [pretty-org]
   :task (shell "sh" "script/pretty/render.sh")}}}
